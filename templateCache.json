n    const menuRoutes = [\n      { title: \"Artists view (example)\", href: \"/artists/decibel_force\" },\n      { title: \"Roadmap\", href: \"/roadmap\" },\n      { title: \"Budget\", href: \"/budget\" },\n    ];\n\n    /**\n     * Maps the JSON routing objects into pure HTML list items.\n     */\n    function compileMenu(items) {\n      const targetContainer = document.getElementById(\"drawer-target\");\n      if (!targetContainer || !items.length) return;\n\n      const compiledHtml = items\n        .map(\n          (item) => `\n        <li>\n          <a href=\"${item.href}\" class=\"drawer-link\">${item.title}</a>\n        </li>\n      `,\n        )\n        .join(\"\\n\");\n\n      targetContainer.innerHTML = compiledHtml;\n    }\n\n    // Trigger target compilation immediately when document mounts\n    document.addEventListener(\"DOMContentLoaded\", () => {\n      compileMenu(menuRoutes);\n    });\n  </script>\n</div>\n\n    </div>\n    <div class=\"artist-hero\">\n  <!-- 1. Responsive Picture Stack -->\n  <picture class=\"hero-picture\">\n    <!-- Mobile Portrait (4:5) (< 640px) -->\n    <source\n      type=\"image/avif\"\n      media=\"(max-width: 639px)\"\n      srcset=\"{{heroImage}}_mobile.avif\"\n    />\n    <source\n      type=\"image/webp\"\n      media=\"(max-width: 639px)\"\n      srcset=\"{{heroImage}}_mobile.webp\"\n    />\n\n    <source\n      type=\"image/avif\"\n      media=\"(max-width: 1023px)\"\n      srcset=\"{{heroImage}}_tablet.avif\"\n    />\n    <source\n      type=\"image/webp\"\n      media=\"(max-width: 1023px)\"\n      srcset=\"{{heroImage}}_tablet.webp\"\n    />\n\n    <!-- Desktop Master (16:9) (>= 1024px) -->\n    <source type=\"image/avif\" srcset=\"{{heroImage}}_desktop.avif\" />\n    <source type=\"image/webp\" srcset=\"{{heroImage}}_desktop.webp\" />\n\n    <!-- Legacy Fallback JPG -->\n    <img\n      src=\"{{heroImage}}_desktop.jpg\"\n      alt=\"{{title}}\"\n      class=\"hero-img\"\n      loading=\"eager\"\n    />\n  </picture>\n\n  <!-- 2. Independent Gradient Overlay for Readability -->\n  <div class=\"hero-gradient-overlay\"></div>\n\n  <!-- 3. Foreground Content Overlay (Aligned to Bottom) -->\n\n  <div class=\"hero-overlay\">\n    <a href=\"/\" class=\"btn-back\">← Back to Archive</a>\n    <h1 class=\"capitalize-words\">{{title}}</h1>\n    <p class=\"performance-count\">{{count}} Documented</p>\n  </div>\n</div>\n\n    <main class=\"performance-grid\">{{gridHtml}}</main>\n  </body>\n</html>\n",
  "PublicPerformanceCard": "<a\n  href=\"/performance/{{link}}\"\n  class=\"card\"\n  style=\"text-decoration: none; color: inherit\"\n>\n  <picture class=\"card-thumbnail\">\n  <source srcset=\"{{cardImage}}.avif\" type=\"image/avif\" />\n  <source srcset=\"{{cardImage}}.webp\" type=\"image/webp\" />\n  <img\n    src=\"{{cardImage}}.jpg\"\n    alt=\"{{formattedVenueName}} - {{formattedDate}}\"\n    loading=\"lazy\"\n    style=\"width: 100%; height: 100%; object-fit: cover; display: block\"\n  />\n</picture>\n\n\n  <div class=\"card-metadata\">\n    <h3 class=\"capitalize-words h3\">{{formattedVenueName}}</h3>\n    <p class=\"date\">{{formattedDate}}</p>\n  </div>\n</a>\n",
  "PublicPerformance": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <link rel=\"icon\" type=\"image/png\" href=\"/favicon-96x96.png\" sizes=\"96x96\" />\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\" />\n    <link rel=\"shortcut icon\" href=\"/favicon.ico\" />\n    <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\" />\n    <link rel=\"manifest\" href=\"/site.webmanifest\" />\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Performance</title>\n    <link rel=\"stylesheet\" href=\"/css/review-studio.css\" />\n  </head>\n  <body>\n    <!-- GLOBAL TOAST NOTIFICATION COMPONENT -->\n<div\n  x-data\n  x-show=\"$store.toast.show\"\n  x-transition:enter=\"toast-enter\"\n  x-transition:enter-start=\"toast-enter-start\"\n  x-transition:enter-end=\"toast-enter-end\"\n  x-transition:leave=\"toast-leave\"\n  x-transition:leave-start=\"toast-leave-start\"\n  x-transition:leave-end=\"toast-leave-end\"\n  x-cloak\n  class=\"toast-container\"\n  :class=\"$store.toast.type\"\n>\n  <div class=\"toast-content\">\n    <span\n      x-text=\"$store.toast.type === 'success' ? '✓' : '⚠'\"\n      class=\"toast-icon\"\n    ></span>\n    <span x-text=\"$store.toast.message\" class=\"toast-message\"></span>\n    <button @click=\"$store.toast.dismiss()\" type=\"button\" class=\"toast-close\">\n      &times;\n    </button>\n  </div>\n</div>\n\n    <div class=\"studio-container\" x-data=\"publicWorkspace\">\n      <section\n  class=\"player-column\"\n  x-data=\"publicWorkspace\"\n  id=\"'publicPlayerColumn\"\n>\n  <div class=\"meta-title-card\">\n    <div><div class=\"menu\">\n  <!-- 1. The Hidden State Controller -->\n  <input type=\"checkbox\" id=\"drawer-toggle\" />\n\n  <!-- 2. The Open Button -->\n  <label for=\"drawer-toggle\" class=\"drawer-trigger\">\n    <svg\n      width=\"18\"\n      height=\"18\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n    >\n      <line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"></line>\n      <line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"></line>\n      <line x1=\"3\" y1=\"18\" x2=\"21\" y2=\"18\"></line>\n    </svg>\n    Menu\n  </label>\n\n  <!-- 3. The Dark Overlay Backdrop (Clicking it closes the drawer) -->\n  <label for=\"drawer-toggle\" class=\"drawer-overlay\"></label>\n\n  <!-- 4. The Drawer Layout Block -->\n  <aside class=\"drawer-panel\">\n    <div class=\"drawer-header\">\n      <h2>Studio Navigation</h2>\n      <label for=\"drawer-toggle\" class=\"drawer-close\" aria-label=\"Close menu\"\n        >&times;</label\n      >\n    </div>\n\n    <!-- JSON Compilation Target -->\n    <ul id=\"drawer-target\" class=\"drawer-links\"></ul>\n  </aside>\n\n  <!-- 5. The Compilation Script -->\n  <script>\n    // JSON Routing Data\n    const menuRoutes = [\n      { title: \"Artists view (example)\", href: \"/artists/decibel_force\" },\n      { title: \"Roadmap\", href: \"/roadmap\" },\n      { title: \"Budget\", href: \"/budget\" },\n    ];\n\n    /**\n     * Maps the JSON routing objects into pure HTML list items.\n     */\n    function compileMenu(items) {\n      const targetContainer = document.getElementById(\"drawer-target\");\n      if (!targetContainer || !items.length) return;\n\n      const compiledHtml = items\n        .map(\n          (item) => `\n        <li>\n          <a href=\"${item.href}\" class=\"drawer-link\">${item.title}</a>\n        </li>\n      `,\n        )\n        .join(\"\\n\");\n\n      targetContainer.innerHTML = compiledHtml;\n    }\n\n    // Trigger target compilation immediately when document mounts\n    document.addEventListener(\"DOMContentLoaded\", () => {\n      compileMenu(menuRoutes);\n    });\n  </script>\n</div>\n</div>\n    <div class=\"meta-title-card-right\">\n      <h2>{{studioTitle}}</h2>\n      <div class=\"toggle\" @click=\"$store.review.togleMode()\">\n        <input type=\"checkbox\" :checked=\"!$store.review.mode\" />\n        <label></label>\n      </div>\n    </div>\n  </div>\n\n  <div\n    :class=\"$store.review.mode ? 'video-player-mock' : 'audio-player-mock'\"\n    style=\"position: relative; overflow: hidden; border-radius: 12px\"\n  >\n    <!-- Video Player View -->\n    <div\n      x-show=\"$store.review.mode && active.source\"\n      style=\"width: 100%; height: 100%; background: #000\"\n    >\n      <div x-show=\"active.source\" style=\"width: 100%; height: 100%; background: #000\">\n  <video\n    id=\"r2-stream-player\"\n    controls\n    playsinline\n    preload=\"metadata\"\n    style=\"width: 100%; height: 100%; object-fit: contain; display: block\"\n  ></video>\n</div>\n\n    </div>\n\n    <!-- Audio Player View -->\n    <div\n      x-show=\"!$store.review.mode && active.source\"\n      class=\"audio-player\"\n      :style=\"active.heroImage ? `background-image: url('${active.heroImage}_desktop.jpg')` : `background-image: url('/screenshots/card/card-fallback.jpg')`\"\n    >\n      <!-- Audio Player Controls Pinned to the Bottom -->\n      <div class=\"audio-player\">\n  <!-- Cassette Artwork Layer -->\n  <img\n    src=\"https://pub-fef6bcaae286450e98785a845f724ff1.r2.dev/images/cassete_icon.jpg\"\n    alt=\"Audio Player Cover\"\n    class=\"audio-player-hero\"\n  />\n\n  <!-- Audio Controls Overlay -->\n  <div class=\"audio-player-controls\">\n    <audio\n      id=\"r2-audio-player\"\n      :src=\"active.sourceMp3\"\n      controls\n      style=\"width: 100%\"\n    ></audio>\n  </div>\n</div>\n\n    </div>\n  </div>\n\n  <div\n  class=\"meta-workspace-card\"\n  x-data=\"{ \n    selectedPlaylist: Object.keys($store.playlists.playlists)[0] || 'favorites' \n  }\"\n>\n  <div class=\"header-row\">\n    <div class=\"studio-controls-group\">\n      <div class=\"input-field-group\">\n        <!-- 1. Bind to local component state variable instead of active.title -->\n        <select x-model=\"selectedPlaylist\">\n          <!-- 2. Loop through your state dynamically, or keep them hardcoded -->\n          <template\n            x-for=\"(list, name) in $store.playlists.playlists\"\n            :key=\"name\"\n          >\n            <option :value=\"name\" x-text=\"name\"></option>\n          </template>\n        </select>\n      </div>\n\n      <!-- 3. Pass the selected playlist target parameter straight to the method -->\n      <button\n        @click=\"$store.playlists.addActiveToPlaylist(selectedPlaylist)\"\n        type=\"button\"\n        class=\"btn-public\"\n      >\n        <span>Add to playlist</span>\n      </button>\n      <button\n        @click=\"$store.playlists.generateShareLink(selectedPlaylist)\"\n        type=\"button\"\n        class=\"btn-public\"\n      >\n        <span>Share playlist</span>\n      </button>\n    </div>\n  </div>\n</div>\n\n</section>\n <aside class=\"playlist-sidebar\">\n  <div class=\"carousel-wrapper\" x-data=\"carousel\">\n    <button\n      type=\"button\"\n      class=\"carousel-nav-btn nav-left\"\n      x-show=\"canScrollLeft\"\n      @click=\"scroll('left')\"\n      x-transition\n      x-cloak\n    >\n      ‹\n    </button>\n\n    <div\n      class=\"sidebar-scroll-list\"\n      x-ref=\"scrollList\"\n      @scroll.debounce.50ms=\"checkScroll()\"\n    >\n      <template\n        x-for=\"(seg, idx) in $store.review.segments\"\n        :key=\"seg.id || idx\"\n      >\n        {{cards}}\n      </template>\n    </div>\n\n    <button\n      type=\"button\"\n      class=\"carousel-nav-btn nav-right\"\n      x-show=\"canScrollRight\"\n      @click=\"scroll('right')\"\n      x-transition\n      x-cloak\n    >\n      ›\n    </button>\n  </div>\n</aside>\n\n    </div>\n\n    <script type=\"application/json\" id=\"studio-segments-data\">\n      {{jsonSegments}}\n    </script>\n  </body>\n  <script type=\"module\" src=\"/js/publicApp.js\"></script>\n</html>\n",
  "PublicSegmentCard": "<div @click=\"$store.review.currentIndex = idx\" class=\"sidebar-item-card\">\n  <div class=\"item-meta\">\n    <picture class=\"item-thumbnail\">\n  <source :srcset=\"`${seg.cardImage}.avif`\" type=\"image/avif\" />\n  <source :srcset=\"`${seg.cardImage}.webp`\" type=\"image/webp\" />\n  <img\n    :src=\"`${seg.cardImage}.jpg`\"\n    :alt=\"seg.title\"\n    loading=\"lazy\"\n    style=\"width: 100%; height: 100%; object-fit: cover; display: block\"\n  />\n</picture>\n\n    <div class=\"title-text\">\n      <!-- FIXED: Linked to the dynamic, reactive title string -->\n      <span x-text=\"seg.formatedDuration\"></span>\n    </div>\n  </div>\n  <div class=\"title-text\">\n    <span x-text=\"seg.title\"></span>\n  </div>\n</div>\n",
  "Missing": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Live Archive</title>\n    <link rel=\"stylesheet\" href=\"/css/main.css\" />\n  </head>\n  <body>\n    <div\n      class=\"artist-hero\"\n      style=\"\n        background-image:\n          linear-gradient(rgba(4, 7, 20, 0.2), rgba(4, 7, 20, 1)),\n          url(&quot;/index.jpg&quot;);\n      \"\n    >\n      <div class=\"hero-overlay\">\n        <a href=\"/\" class=\"btn-back\">← Back to Archive</a>\n        <h1 class=\"capitalize-words\">Artist not found</h1>\n      </div>\n    </div>\n\n    <script src=\"/js/prefetch.js\" defer></script>\n  </body>\n</html>\n"
}
