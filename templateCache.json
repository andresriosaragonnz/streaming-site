gger the open states when the hidden checkbox is checked */\n    #drawer-toggle:checked ~ .drawer-overlay {\n      opacity: 1;\n      pointer-events: auto;\n    }\n    #drawer-toggle:checked ~ .drawer-panel {\n      transform: translateX(0);\n    }\n\n    /* \n     * DRAWER INTERIOR STYLING \n     */\n    .drawer-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding: 24px 20px;\n      border-bottom: 1px solid #1f2937;\n    }\n    .drawer-header h2 {\n      margin: 0;\n      font-size: 1.1rem;\n      font-weight: 700;\n      color: #ffffff;\n    }\n\n    /* Close button inside the drawer */\n    .drawer-close {\n      color: #9ca3af;\n      font-size: 1.5rem;\n      line-height: 1;\n      cursor: pointer;\n      transition: color 0.2s ease;\n    }\n    .drawer-close:hover {\n      color: #ffffff;\n    }\n\n    /* Link list styling */\n    .drawer-links {\n      list-style: none;\n      margin: 0;\n      padding: 12px;\n      display: flex;\n      flex-direction: column;\n      gap: 4px;\n    }\n    .drawer-link {\n      display: block;\n      padding: 12px 16px;\n      color: #d1d5db;\n      text-decoration: none;\n      font-size: 0.95rem;\n      font-weight: 500;\n      border-radius: 8px;\n      transition: all 0.2s ease;\n    }\n    .drawer-link:hover {\n      background-color: #1f2937;\n      color: #ffffff;\n    }\n  </style>\n\n  <!-- 1. The Hidden State Controller -->\n  <input type=\"checkbox\" id=\"drawer-toggle\" />\n\n  <!-- 2. The Open Button -->\n  <label for=\"drawer-toggle\" class=\"drawer-trigger\">\n    <svg\n      width=\"18\"\n      height=\"18\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n    >\n      <line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"></line>\n      <line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"></line>\n      <line x1=\"3\" y1=\"18\" x2=\"21\" y2=\"18\"></line>\n    </svg>\n    Menu\n  </label>\n\n  <!-- 3. The Dark Overlay Backdrop (Clicking it closes the drawer) -->\n  <label for=\"drawer-toggle\" class=\"drawer-overlay\"></label>\n\n  <!-- 4. The Drawer Layout Block -->\n  <aside class=\"drawer-panel\">\n    <div class=\"drawer-header\">\n      <h2>Studio Navigation</h2>\n      <label for=\"drawer-toggle\" class=\"drawer-close\" aria-label=\"Close menu\"\n        >&times;</label\n      >\n    </div>\n\n    <!-- JSON Compilation Target -->\n    <ul id=\"drawer-target\" class=\"drawer-links\"></ul>\n  </aside>\n\n  <!-- 5. The Compilation Script -->\n  <script>\n    // JSON Routing Data\n    const menuRoutes = [\n      { title: \"Artists view (example)\", href: \"/artists/decibel_force\" },\n      { title: \"Roadmap\", href: \"/roadmap\" },\n      { title: \"Budget\", href: \"/budget\" },\n    ];\n\n    /**\n     * Maps the JSON routing objects into pure HTML list items.\n     */\n    function compileMenu(items) {\n      const targetContainer = document.getElementById(\"drawer-target\");\n      if (!targetContainer || !items.length) return;\n\n      const compiledHtml = items\n        .map(\n          (item) => `\n        <li>\n          <a href=\"${item.href}\" class=\"drawer-link\">${item.title}</a>\n        </li>\n      `,\n        )\n        .join(\"\\n\");\n\n      targetContainer.innerHTML = compiledHtml;\n    }\n\n    // Trigger target compilation immediately when document mounts\n    document.addEventListener(\"DOMContentLoaded\", () => {\n      compileMenu(menuRoutes);\n    });\n  </script>\n</div>\n</div>\n    <div class=\"meta-title-card-right\">\n      <h2>{{studioTitle}}</h2>\n      <div class=\"toggle\" @click=\"$store.review.togleMode()\">\n        <input type=\"checkbox\" :checked=\"!$store.review.mode\" />\n        <label></label>\n      </div>\n    </div>\n  </div>\n\n  <div\n    :class=\"$store.review.mode ? 'video-player-mock' : 'audio-player-mock'\"\n    style=\"position: relative; overflow: hidden; border-radius: 12px\"\n  >\n    <!-- Video Player View -->\n    <div\n      x-show=\"$store.review.mode && active.source\"\n      style=\"width: 100%; height: 100%; background: #000\"\n    >\n      <div x-show=\"active.source\" style=\"width: 100%; height: 100%; background: #000\">\n  <video\n    id=\"r2-stream-player\"\n    controls\n    playsinline\n    preload=\"metadata\"\n    style=\"width: 100%; height: 100%; object-fit: contain; display: block\"\n  ></video>\n</div>\n\n    </div>\n\n    <!-- Audio Player View -->\n    <div\n      x-show=\"!$store.review.mode && active.source\"\n      class=\"audio-player\"\n      :style=\"active.heroImage ? `background-image: url('${active.heroImage}_desktop.jpg')` : `background-image: url('/screenshots/card/card-fallback.jpg')`\"\n    >\n      <!-- Audio Player Controls Pinned to the Bottom -->\n      <div class=\"audio-player\">\n  <!-- Cassette Artwork Layer -->\n  <img\n    src=\"https://pub-fef6bcaae286450e98785a845f724ff1.r2.dev/images/cassete_icon.jpg\"\n    alt=\"Audio Player Cover\"\n    class=\"audio-player-hero\"\n  />\n\n  <!-- Audio Controls Overlay -->\n  <div class=\"audio-player-controls\">\n    <audio\n      id=\"r2-audio-player\"\n      :src=\"active.sourceMp3\"\n      controls\n      style=\"width: 100%\"\n    ></audio>\n  </div>\n</div>\n\n    </div>\n  </div>\n\n  <div\n  class=\"meta-workspace-card\"\n  x-data=\"{ \n    selectedPlaylist: Object.keys($store.playlists.playlists)[0] || 'favorites' \n  }\"\n>\n  <div class=\"header-row\">\n    <div class=\"studio-controls-group\">\n      <div class=\"input-field-group\">\n        <!-- 1. Bind to local component state variable instead of active.title -->\n        <select x-model=\"selectedPlaylist\">\n          <!-- 2. Loop through your state dynamically, or keep them hardcoded -->\n          <template\n            x-for=\"(list, name) in $store.playlists.playlists\"\n            :key=\"name\"\n          >\n            <option :value=\"name\" x-text=\"name\"></option>\n          </template>\n        </select>\n      </div>\n\n      <!-- 3. Pass the selected playlist target parameter straight to the method -->\n      <button\n        @click=\"$store.playlists.addActiveToPlaylist(selectedPlaylist)\"\n        type=\"button\"\n        class=\"btn-public\"\n      >\n        <span>Add to playlist</span>\n      </button>\n      <button\n        @click=\"$store.playlists.generateShareLink(selectedPlaylist)\"\n        type=\"button\"\n        class=\"btn-public\"\n      >\n        <span>Share playlist</span>\n      </button>\n    </div>\n  </div>\n</div>\n\n</section>\n <aside class=\"playlist-sidebar\">\n  <div class=\"carousel-wrapper\" x-data=\"carousel\">\n    <button\n      type=\"button\"\n      class=\"carousel-nav-btn nav-left\"\n      x-show=\"canScrollLeft\"\n      @click=\"scroll('left')\"\n      x-transition\n      x-cloak\n    >\n      ‹\n    </button>\n\n    <div\n      class=\"sidebar-scroll-list\"\n      x-ref=\"scrollList\"\n      @scroll.debounce.50ms=\"checkScroll()\"\n    >\n      <template\n        x-for=\"(seg, idx) in $store.review.segments\"\n        :key=\"seg.id || idx\"\n      >\n        {{cards}}\n      </template>\n    </div>\n\n    <button\n      type=\"button\"\n      class=\"carousel-nav-btn nav-right\"\n      x-show=\"canScrollRight\"\n      @click=\"scroll('right')\"\n      x-transition\n      x-cloak\n    >\n      ›\n    </button>\n  </div>\n</aside>\n\n    </div>\n\n    <script type=\"application/json\" id=\"studio-segments-data\">\n      {{jsonSegments}}\n    </script>\n  </body>\n  <script type=\"module\" src=\"/js/privateApp.js\"></script>\n</html>\n","PublicSegmentCard":"<div @click=\"$store.review.currentIndex = idx\" class=\"sidebar-item-card\">\n  <picture class=\"item-thumbnail\">\n  <source :srcset=\"`${seg.cardImage}.avif`\" type=\"image/avif\" />\n  <source :srcset=\"`${seg.cardImage}.webp`\" type=\"image/webp\" />\n  <img\n    :src=\"`${seg.cardImage}.jpg`\"\n    :alt=\"seg.title\"\n    loading=\"lazy\"\n    style=\"width: 100%; height: 100%; object-fit: cover; display: block\"\n  />\n</picture>\n\n\n  <div class=\"item-meta\">\n    <div class=\"title-text\">\n      <!-- FIXED: Linked to the dynamic, reactive title string -->\n      <span x-text=\"seg.title\"></span>\n    </div>\n    <div class=\"title-text\">\n      <span x-text=\"seg.formatedDuration\"></span>\n    </div>\n  </div>\n</div>\n"}