{"PrivateDashboard":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>{{pageTitle}} | Live Archive</title>\n    <link rel=\"stylesheet\" href=\"/css/main.css\" />\n  </head>\n  <body>\n    <div style=\"position: fixed; z-index: 20; padding: 4rem\">\n      <div class=\"menu\">\n  <style>\n    /* Baseline Wrapper (Invisible so it doesn't break main page layouts) */\n    .menu {\n      font-family:\n        system-ui,\n        -apple-system,\n        sans-serif;\n    }\n\n    /* \n     * PURE CSS DRAWER MECHANICS \n     */\n\n    /* 1. Hide the structural checkbox completely */\n    #drawer-toggle {\n      display: none;\n    }\n\n    /* 2. Style the trigger button (Hamburger Menu) - NOW FIXED/STICKY */\n    .drawer-trigger {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      background-color: #1f2937;\n      color: #ffffff;\n      padding: 10px 16px;\n      border-radius: 8px;\n      cursor: pointer;\n      font-weight: 600;\n      font-size: 0.95rem;\n      border: 1px solid #374151;\n      transition: background-color 0.2s ease;\n      user-select: none;\n\n      /* Sticky/Fixed Positioning */\n\n      z-index: 30; /* Keeps it above content, but below the dark overlay (40) */\n    }\n    .drawer-trigger:hover {\n      background-color: #374151;\n    }\n\n    /* 3. The dark background overlay */\n    .drawer-overlay {\n      position: fixed;\n      top: 0;\n      left: 0;\n      width: 100vw;\n      height: 100vh;\n      background-color: rgba(0, 0, 0, 0.6);\n      backdrop-filter: blur(4px);\n      -webkit-backdrop-filter: blur(4px);\n      opacity: 0;\n      pointer-events: none; /* Ignore clicks when hidden */\n      transition: opacity 0.3s ease;\n      z-index: 40;\n    }\n\n    /* 4. The Drawer Panel itself */\n    .drawer-panel {\n      position: fixed;\n      top: 0;\n      left: 0;\n      width: 280px;\n      height: 100vh;\n      background-color: #111827;\n      border-right: 1px solid #1f2937;\n      box-shadow: 4px 0 24px rgba(0, 0, 0, 0.5);\n      transform: translateX(-100%); /* Push completely off-screen */\n      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n      z-index: 50;\n      display: flex;\n      flex-direction: column;\n    }\n\n    /* 5. Trigger the open states when the hidden checkbox is checked */\n    #drawer-toggle:checked ~ .drawer-overlay {\n      opacity: 1;\n      pointer-events: auto;\n    }\n    #drawer-toggle:checked ~ .drawer-panel {\n      transform: translateX(0);\n    }\n\n    /* \n     * DRAWER INTERIOR STYLING \n     */\n    .drawer-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding: 24px 20px;\n      border-bottom: 1px solid #1f2937;\n    }\n    .drawer-header h2 {\n      margin: 0;\n      font-size: 1.1rem;\n      font-weight: 700;\n      color: #ffffff;\n    }\n\n    /* Close button inside the drawer */\n    .drawer-close {\n      color: #9ca3af;\n      font-size: 1.5rem;\n      line-height: 1;\n      cursor: pointer;\n      transition: color 0.2s ease;\n    }\n    .drawer-close:hover {\n      color: #ffffff;\n    }\n\n    /* Link list styling */\n    .drawer-links {\n      list-style: none;\n      margin: 0;\n      padding: 12px;\n      display: flex;\n      flex-direction: column;\n      gap: 4px;\n    }\n    .drawer-link {\n      display: block;\n      padding: 12px 16px;\n      color: #d1d5db;\n      text-decoration: none;\n      font-size: 0.95rem;\n      font-weight: 500;\n      border-radius: 8px;\n      transition: all 0.2s ease;\n    }\n    .drawer-link:hover {\n      background-color: #1f2937;\n      color: #ffffff;\n    }\n  </style>\n\n  <!-- 1. The Hidden State Controller -->\n  <input type=\"checkbox\" id=\"drawer-toggle\" />\n\n  <!-- 2. The Open Button -->\n  <label for=\"drawer-toggle\" class=\"drawer-trigger\">\n    <svg\n      width=\"18\"\n      height=\"18\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n    >\n      <line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"></line>\n      <line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"></line>\n      <line x1=\"3\" y1=\"18\" x2=\"21\" y2=\"18\"></line>\n    </svg>\n    Menu\n  </label>\n\n  <!-- 3. The Dark Overlay Backdrop (Clicking it closes the drawer) -->\n  <label for=\"drawer-toggle\" class=\"drawer-overlay\"></label>\n\n  <!-- 4. The Drawer Layout Block -->\n  <aside class=\"drawer-panel\">\n    <div class=\"drawer-header\">\n      <h2>Studio Navigation</h2>\n      <label for=\"drawer-toggle\" class=\"drawer-close\" aria-label=\"Close menu\"\n        >&times;</label\n      >\n    </div>\n\n    <!-- JSON Compilation Target -->\n    <ul id=\"drawer-target\" class=\"drawer-links\"></ul>\n  </aside>\n\n  <!-- 5. The Compilation Script -->\n  <script>\n    // JSON Routing Data\n    const menuRoutes = [\n      { title: \"Artists view (example)\", href: \"/artists/decibel_force\" },\n      { title: \"Roadmap\", href: \"/roadmap\" },\n      { title: \"Budget\", href: \"/budget\" },\n    ];\n\n    /**\n     * Maps the JSON routing objects into pure HTML list items.\n     */\n    function compileMenu(items) {\n      const targetContainer = document.getElementById(\"drawer-target\");\n      if (!targetContainer || !items.length) return;\n\n      const compiledHtml = items\n        .map(\n          (item) => `\n        <li>\n          <a href=\"${item.href}\" class=\"drawer-link\">${item.title}</a>\n        </li>\n      `,\n        )\n        .join(\"\\n\");\n\n      targetContainer.innerHTML = compiledHtml;\n    }\n\n    // Trigger target compilation immediately when document mounts\n    document.addEventListener(\"DOMContentLoaded\", () => {\n      compileMenu(menuRoutes);\n    });\n  </script>\n</div>\n\n    </div>\n    <div class=\"artist-hero\">\n  <!-- 1. Responsive Picture Stack -->\n  <picture class=\"hero-picture\">\n    <!-- Mobile Portrait (4:5) (< 640px) -->\n    <source\n      type=\"image/avif\"\n      media=\"(max-width: 639px)\"\n      srcset=\"{{heroImage}}_mobile.avif\"\n    />\n    <source\n      type=\"image/webp\"\n      media=\"(max-width: 639px)\"\n      srcset=\"{{heroImage}}_mobile.webp\"\n    />\n\n    <source\n      type=\"image/avif\"\n      media=\"(max-width: 1023px)\"\n      srcset=\"{{heroImage}}_tablet.avif\"\n    />\n    <source\n      type=\"image/webp\"\n      media=\"(max-width: 1023px)\"\n      srcset=\"{{heroImage}}_tablet.webp\"\n    />\n\n    <!-- Desktop Master (16:9) (>= 1024px) -->\n    <source type=\"image/avif\" srcset=\"{{heroImage}}_desktop.avif\" />\n    <source type=\"image/webp\" srcset=\"{{heroImage}}_desktop.webp\" />\n\n    <!-- Legacy Fallback JPG -->\n    <img\n      src=\"{{heroImage}}_desktop.jpg\"\n      alt=\"{{title}}\"\n      class=\"hero-img\"\n      loading=\"eager\"\n    />\n  </picture>\n\n  <!-- 2. Independent Gradient Overlay for Readability -->\n  <div class=\"hero-gradient-overlay\"></div>\n\n  <!-- 3. Foreground Content Overlay (Aligned to Bottom) -->\n\n  <div class=\"hero-overlay\">\n    <a href=\"/\" class=\"btn-back\">← Back to Archive</a>\n    <h1 class=\"capitalize-words\">{{title}}</h1>\n    <p class=\"performance-count\">{{count}} Documented</p>\n  </div>\n</div>\n\n    <main class=\"performance-grid\">{{gridHtml}}</main>\n  </body>\n</html>\n","PrivatePerformanceCard":"<a\n  href=\"/private/performance/{{link}}\"\n  class=\"card\"\n  style=\"text-decoration: none; color: inherit\"\n>\n  <picture class=\"card-thumbnail\">\n  <source srcset=\"{{cardImage}}.avif\" type=\"image/avif\" />\n  <source srcset=\"{{cardImage}}.webp\" type=\"image/webp\" />\n  <img\n    src=\"{{cardImage}}.jpg\"\n    alt=\"{{formattedVenueName}} - {{formattedDate}}\"\n    loading=\"lazy\"\n    style=\"width: 100%; height: 100%; object-fit: cover; display: block\"\n  />\n</picture>\n\n\n  <div class=\"card-metadata\">\n    <h3 class=\"capitalize-words\">{{formattedVenueName}}</h3>\n    <p class=\"date\">{{formattedDate}}</p>\n  </div>\n</a>\n","PrivatePerformance":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>{{pageTitle}} | Live Archive</title>\n    <link rel=\"stylesheet\" href=\"/css/review-studio.css\" />\n  </head>\n  <body>\n    <div class=\"studio-container\" x-data=\"privateWorkspace\">\n      <section class=\"player-column\">\n  <div class=\"meta-title-card\">\n    <div><div class=\"menu\">\n  <style>\n    /* Baseline Wrapper (Invisible so it doesn't break main page layouts) */\n    .menu {\n      font-family:\n        system-ui,\n        -apple-system,\n        sans-serif;\n    }\n\n    /* \n     * PURE CSS DRAWER MECHANICS \n     */\n\n    /* 1. Hide the structural checkbox completely */\n    #drawer-toggle {\n      display: none;\n    }\n\n    /* 2. Style the trigger button (Hamburger Menu) - NOW FIXED/STICKY */\n    .drawer-trigger {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      background-color: #1f2937;\n      color: #ffffff;\n      padding: 10px 16px;\n      border-radius: 8px;\n      cursor: pointer;\n      font-weight: 600;\n      font-size: 0.95rem;\n      border: 1px solid #374151;\n      transition: background-color 0.2s ease;\n      user-select: none;\n\n      /* Sticky/Fixed Positioning */\n\n      z-index: 30; /* Keeps it above content, but below the dark overlay (40) */\n    }\n    .drawer-trigger:hover {\n      background-color: #374151;\n    }\n\n    /* 3. The dark background overlay */\n    .drawer-overlay {\n      position: fixed;\n      top: 0;\n      left: 0;\n      width: 100vw;\n      height: 100vh;\n      background-color: rgba(0, 0, 0, 0.6);\n      backdrop-filter: blur(4px);\n      -webkit-backdrop-filter: blur(4px);\n      opacity: 0;\n      pointer-events: none; /* Ignore clicks when hidden */\n      transition: opacity 0.3s ease;\n      z-index: 40;\n    }\n\n    /* 4. The Drawer Panel itself */\n    .drawer-panel {\n      position: fixed;\n      top: 0;\n      left: 0;\n      width: 280px;\n      height: 100vh;\n      background-color: #111827;\n      border-right: 1px solid #1f2937;\n      box-shadow: 4px 0 24px rgba(0, 0, 0, 0.5);\n      transform: translateX(-100%); /* Push completely off-screen */\n      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n      z-index: 50;\n      display: flex;\n      flex-direction: column;\n    }\n\n    /* 5. Trigger the open states when the hidden checkbox is checked */\n    #drawer-toggle:checked ~ .drawer-overlay {\n      opacity: 1;\n      pointer-events: auto;\n    }\n    #drawer-toggle:checked ~ .drawer-panel {\n      transform: translateX(0);\n    }\n\n    /* \n     * DRAWER INTERIOR STYLING \n     */\n    .drawer-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding: 24px 20px;\n      border-bottom: 1px solid #1f2937;\n    }\n    .drawer-header h2 {\n      margin: 0;\n      font-size: 1.1rem;\n      font-weight: 700;\n      color: #ffffff;\n    }\n\n    /* Close button inside the drawer */\n    .drawer-close {\n      color: #9ca3af;\n      font-size: 1.5rem;\n      line-height: 1;\n      cursor: pointer;\n      transition: color 0.2s ease;\n    }\n    .drawer-close:hover {\n      color: #ffffff;\n    }\n\n    /* Link list styling */\n    .drawer-links {\n      list-style: none;\n      margin: 0;\n      padding: 12px;\n      display: flex;\n      flex-direction: column;\n      gap: 4px;\n    }\n    .drawer-link {\n      display: block;\n      padding: 12px 16px;\n      color: #d1d5db;\n      text-decoration: none;\n      font-size: 0.95rem;\n      font-weight: 500;\n      border-radius: 8px;\n      transition: all 0.2s ease;\n    }\n    .drawer-link:hover {\n      background-color: #1f2937;\n      color: #ffffff;\n    }\n  </style>\n\n  <!-- 1. The Hidden State Controller -->\n  <input type=\"checkbox\" id=\"drawer-toggle\" />\n\n  <!-- 2. The Open Button -->\n  <label for=\"drawer-toggle\" class=\"drawer-trigger\">\n    <svg\n      width=\"18\"\n      height=\"18\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n    >\n      <line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"></line>\n      <line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"></line>\n      <line x1=\"3\" y1=\"18\" x2=\"21\" y2=\"18\"></line>\n    </svg>\n    Menu\n  </label>\n\n  <!-- 3. The Dark Overlay Backdrop (Clicking it closes the drawer) -->\n  <label for=\"drawer-toggle\" class=\"drawer-overlay\"></label>\n\n  <!-- 4. The Drawer Layout Block -->\n  <aside class=\"drawer-panel\">\n    <div class=\"drawer-header\">\n      <h2>Studio Navigation</h2>\n      <label for=\"drawer-toggle\" class=\"drawer-close\" aria-label=\"Close menu\"\n        >&times;</label\n      >\n    </div>\n\n    <!-- JSON Compilation Target -->\n    <ul id=\"drawer-target\" class=\"drawer-links\"></ul>\n  </aside>\n\n  <!-- 5. The Compilation Script -->\n  <script>\n    // JSON Routing Data\n    const menuRoutes = [\n      { title: \"Artists view (example)\", href: \"/artists/decibel_force\" },\n      { title: \"Roadmap\", href: \"/roadmap\" },\n      { title: \"Budget\", href: \"/budget\" },\n    ];\n\n    /**\n     * Maps the JSON routing objects into pure HTML list items.\n     */\n    function compileMenu(items) {\n      const targetContainer = document.getElementById(\"drawer-target\");\n      if (!targetContainer || !items.length) return;\n\n      const compiledHtml = items\n        .map(\n          (item) => `\n        <li>\n          <a href=\"${item.href}\" class=\"drawer-link\">${item.title}</a>\n        </li>\n      `,\n        )\n        .join(\"\\n\");\n\n      targetContainer.innerHTML = compiledHtml;\n    }\n\n    // Trigger target compilation immediately when document mounts\n    document.addEventListener(\"DOMContentLoaded\", () => {\n      compileMenu(menuRoutes);\n    });\n  </script>\n</div>\n</div>\n    <div class=\"meta-title-card-right\">\n      <h2>{{studioTitle}}</h2>\n    </div>\n  </div>\n\n  <div class=\"video-player-mock\">\n    <div\n      x-show=\"active.source\"\n      style=\"width: 100%; height: 100%; background: #000\"\n    >\n      <div x-show=\"active.source\" style=\"width: 100%; height: 100%; background: #000\">\n  <video\n    id=\"r2-stream-player\"\n    controls\n    playsinline\n    preload=\"metadata\"\n    style=\"width: 100%; height: 100%; object-fit: contain; display: block\"\n  ></video>\n</div>\n\n    </div>\n  </div>\n\n  <div class=\"meta-workspace-card\">\n  <div class=\"studio-controls-group\">\n    <div class=\"input-field-group\">\n      <input\n        type=\"text\"\n        x-model=\"active.title\"\n        @input=\"$store.review.syncStore($store.review.currentIndex, active.title)\"\n      />\n    </div>\n\n    <button\n      @click=\"$store.review.toggleStatus($store.review.currentIndex)\"\n      type=\"button\"\n      class=\"btn-status\"\n      :class=\"active.status === 'public' ? 'btn-public' : 'btn-private'\"\n    >\n      <span x-text=\"active.status === 'public' ? 'Public' : 'Private'\"></span>\n    </button>\n    <div class=\"studio-controls-status-count-container\">\n      <span\n        x-text=\"$store.review.getCount()\"\n        class=\"studio-controls-status-count\"\n      ></span>\n      <span\n        x-text=\"$store.review.getCountPrivate()\"\n        class=\"studio-controls-status-count\"\n      ></span>\n    </div>\n    <div class=\"status-action-wrapper\">\n      <!-- Commit Action -->\n      <button\n        x-show=\"$store.review.hasStatusChanged()\"\n        @click=\"$store.review.openCommitModal()\"\n        type=\"button\"\n        class=\"btn-status btn-public\"\n      >\n        <span>Commit</span>\n      </button>\n    </div>\n  </div>\n  <!-- COMMIT MODAL TEMPLATE -->\n<div\n  x-show=\"$store.review.isCommitModalOpen\"\n  x-cloak\n  @keydown.escape.window=\"$store.review.closeCommitModal()\"\n  class=\"modal-backdrop\"\n>\n  <div @click.away=\"$store.review.closeCommitModal()\" class=\"modal-card\">\n    <div class=\"modal-header\">\n      <h2>Review Public Segments</h2>\n      <p class=\"modal-subtitle\">The following segments will be made public:</p>\n    </div>\n\n    <!-- List of changed segments -->\n    <ul class=\"commit-segment-list\">\n      <template\n        x-for=\"(seg, idx) in $store.review.getPublicSegments()\"\n        :key=\"seg.id ?? idx\"\n      >\n        <li class=\"commit-segment-item\">\n          <span x-text=\"seg.title\" class=\"segment-title\"></span>\n          <span\n            x-text=\"seg.status\"\n            :class=\"seg.status === 'public' ? 'status-tag-public' : 'status-tag-private'\"\n            class=\"status-tag\"\n          ></span>\n        </li>\n      </template>\n    </ul>\n\n    <!-- APRA AMCOS DIRECT LICENSING AGREEMENT -->\n    <div\n      x-data=\"{ agreed: false, expanded: false }\"\n      class=\"license-agreement-container\"\n    >\n      <div class=\"agreement-header\">\n        <label class=\"checkbox-label\">\n          <input type=\"checkbox\" x-model=\"agreed\" id=\"apra-agreement-check\" />\n          <span\n            >I agree to the Direct Synchronisation & Online Streaming\n            Licence</span\n          >\n        </label>\n\n        <button\n          type=\"button\"\n          class=\"btn-toggle-terms\"\n          @click=\"expanded = !expanded\"\n          x-text=\"expanded ? 'Hide Terms ▲' : 'View Terms ▼'\"\n        >\n          View Terms ▼\n        </button>\n      </div>\n\n      <!-- Expandable Terms Container -->\n\n      <div x-show=\"expanded\" x-collapse class=\"contract-body\">\n  <h4>DIRECT SYNCHRONISATION AND ONLINE STREAMING LICENCE AGREEMENT</h4>\n\n  <p>\n    <strong>1. PARTIES</strong><br />\n    This Agreement is between the Platform and the undersigned artist/copyright\n    owner (\"Licensor\").\n  </p>\n\n  <p>\n    <strong>2. GRANT OF LICENCE</strong><br />\n    The Licensor grants the Platform a worldwide, non-exclusive, royalty-free,\n    direct licence to:<br />\n    a) Synchronize the musical composition and sound recording entitled\n    <strong x-text=\"active?.title || 'the selected works'\"></strong> with video\n    footage uploaded by the videographer.<br />\n    b) Stream, transmit, and display the resulting audiovisual work on the\n    Platform's website and related non-commercial channels.\n  </p>\n\n  <p>\n    <strong>3. DIRECT LICENSING DECLARATION (APRA AMCOS BYPASS)</strong><br />\n    The Licensor acknowledges that they retain full ownership of the Work.\n    Pursuant to APRA AMCOS direct licensing rules, the Licensor explicitly\n    authorizes the Platform to stream and synchronize the Work without requiring\n    third-party licensing or fee collection from APRA AMCOS or PPCA.\n  </p>\n\n  <p>\n    <strong>4. WARRANTIES & INDEMNITY</strong><br />\n    The Licensor warrants that:<br />\n    a) They are the sole creator and copyright owner of the Work, or hold all\n    necessary authority to grant this licence.<br />\n    b) The Work is 100% original and contains no unlicensed third-party samples,\n    cover compositions, or unauthorized media.<br />\n    c) The Licensor agrees to indemnify and hold harmless the Platform against\n    any third-party copyright claims or licensing demands arising from the\n    streaming of this Work.\n  </p>\n\n  <p>\n    <strong>5. TERM & TERMINATION</strong><br />\n    This licence remains in effect indefinitely until revoked in writing by the\n    Licensor. Upon receiving a written revocation, the Platform shall remove the\n    media within 5 business days.\n  </p>\n</div>\n\n      <!-- Modal Actions Gated by Checkbox -->\n      <div class=\"modal-actions\">\n        <button\n          @click=\"$store.review.closeCommitModal()\"\n          type=\"button\"\n          class=\"btn-modal btn-modal-cancel\"\n        >\n          Cancel\n        </button>\n        <button\n          @click=\"$store.review.submitCommit()\"\n          type=\"button\"\n          :disabled=\"!agreed\"\n          class=\"btn-modal btn-modal-confirm\"\n        >\n          Confirm Changes\n        </button>\n      </div>\n    </div>\n  </div>\n</div>\n\n</div>\n\n</section>\n <aside class=\"playlist-sidebar\">\n  <div class=\"carousel-wrapper\" x-data=\"carousel\">\n    <button\n      type=\"button\"\n      class=\"carousel-nav-btn nav-left\"\n      x-show=\"canScrollLeft\"\n      @click=\"scroll('left')\"\n      x-transition\n      x-cloak\n    >\n      ‹\n    </button>\n\n    <div\n      class=\"sidebar-scroll-list\"\n      x-ref=\"scrollList\"\n      @scroll.debounce.50ms=\"checkScroll()\"\n    >\n      <template\n        x-for=\"(seg, idx) in $store.review.segments\"\n        :key=\"seg.id || idx\"\n      >\n        {{cards}}\n      </template>\n    </div>\n\n    <button\n      type=\"button\"\n      class=\"carousel-nav-btn nav-right\"\n      x-show=\"canScrollRight\"\n      @click=\"scroll('right')\"\n      x-transition\n      x-cloak\n    >\n      ›\n    </button>\n  </div>\n</aside>\n\n    </div>\n\n    <script type=\"application/json\" id=\"studio-segments-data\">\n      {{jsonSegments}}\n    </script>\n  </body>\n  <script type=\"module\" src=\"/js/privateApp.js\"></script>\n</html>\n","PrivateSegmentCard":"<div\n  @click=\"$store.review.currentIndex = idx\"\n  class=\"sidebar-item-card\"\n  :class=\"[\n    $store.review.currentIndex === idx ? 'item-active-highlight' : '',\n    seg.status === 'private' ? 'sidebar-item-card-private' : 'sidebar-item-card'\n  ]\"\n>\n  <picture class=\"item-thumbnail\">\n  <source :srcset=\"`${seg.cardImage}.avif`\" type=\"image/avif\" />\n  <source :srcset=\"`${seg.cardImage}.webp`\" type=\"image/webp\" />\n  <img\n    :src=\"`${seg.cardImage}.jpg`\"\n    :alt=\"seg.title\"\n    loading=\"lazy\"\n    style=\"width: 100%; height: 100%; object-fit: cover; display: block\"\n  />\n</picture>\n\n\n  <div class=\"item-meta\">\n    <div class=\"title-text\">\n      <!-- FIXED: Linked to the dynamic, reactive title string -->\n      <span x-text=\"seg.title\"></span>\n    </div>\n    <div class=\"title-text\">\n      <span x-text=\"seg.status === 'public' ? 'Public' : 'Private'\"\n        >Private</span\n      >\n    </div>\n  </div>\n</div>\n","PublicPortfolio":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <link rel=\"icon\" type=\"image/png\" href=\"/favicon-96x96.png\" sizes=\"96x96\" />\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\" />\n    <link rel=\"shortcut icon\" href=\"/favicon.ico\" />\n    <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\" />\n    <link rel=\"manifest\" href=\"/site.webmanifest\" />\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>{{pageTitle}} | Live Archive</title>\n    <link rel=\"stylesheet\" href=\"/css/main.css\" />\n  </head>\n  <body>\n    <div style=\"position: fixed; z-index: 20; padding: 4rem\">\n      <div class=\"menu\">\n  <style>\n    /* Baseline Wrapper (Invisible so it doesn't break main page layouts) */\n    .menu {\n      font-family:\n        system-ui,\n        -apple-system,\n        sans-serif;\n    }\n\n    /* \n     * PURE CSS DRAWER MECHANICS \n     */\n\n    /* 1. Hide the structural checkbox completely */\n    #drawer-toggle {\n      display: none;\n    }\n\n    /* 2. Style the trigger button (Hamburger Menu) - NOW FIXED/STICKY */\n    .drawer-trigger {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      background-color: #1f2937;\n      color: #ffffff;\n      padding: 10px 16px;\n      border-radius: 8px;\n      cursor: pointer;\n      font-weight: 600;\n      font-size: 0.95rem;\n      border: 1px solid #374151;\n      transition: background-color 0.2s ease;\n      user-select: none;\n\n      /* Sticky/Fixed Positioning */\n\n      z-index: 30; /* Keeps it above content, but below the dark overlay (40) */\n    }\n    .drawer-trigger:hover {\n      background-color: #374151;\n    }\n\n    /* 3. The dark background overlay */\n    .drawer-overlay {\n      position: fixed;\n      top: 0;\n      left: 0;\n      width: 100vw;\n      height: 100vh;\n      background-color: rgba(0, 0, 0, 0.6);\n      backdrop-filter: blur(4px);\n      -webkit-backdrop-filter: blur(4px);\n      opacity: 0;\n      pointer-events: none; /* Ignore clicks when hidden */\n      transition: opacity 0.3s ease;\n      z-index: 40;\n    }\n\n    /* 4. The Drawer Panel itself */\n    .drawer-panel {\n      position: fixed;\n      top: 0;\n      left: 0;\n      width: 280px;\n      height: 100vh;\n      background-color: #111827;\n      border-right: 1px solid #1f2937;\n      box-shadow: 4px 0 24px rgba(0, 0, 0, 0.5);\n      transform: translateX(-100%); /* Push completely off-screen */\n      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n      z-index: 50;\n      display: flex;\n      flex-direction: column;\n    }\n\n    /* 5. Trigger the open states when the hidden checkbox is checked */\n    #drawer-toggle:checked ~ .drawer-overlay {\n      opacity: 1;\n      pointer-events: auto;\n    }\n    #drawer-toggle:checked ~ .drawer-panel {\n      transform: translateX(0);\n    }\n\n    /* \n     * DRAWER INTERIOR STYLING \n     */\n    .drawer-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding: 24px 20px;\n      border-bottom: 1px solid #1f2937;\n    }\n    .drawer-header h2 {\n      margin: 0;\n      font-size: 1.1rem;\n      font-weight: 700;\n      color: #ffffff;\n    }\n\n    /* Close button inside the drawer */\n    .drawer-close {\n      color: #9ca3af;\n      font-size: 1.5rem;\n      line-height: 1;\n      cursor: pointer;\n      transition: color 0.2s ease;\n    }\n    .drawer-close:hover {\n      color: #ffffff;\n    }\n\n    /* Link list styling */\n    .drawer-links {\n      list-style: none;\n      margin: 0;\n      padding: 12px;\n      display: flex;\n      flex-direction: column;\n      gap: 4px;\n    }\n    .drawer-link {\n      display: block;\n      padding: 12px 16px;\n      color: #d1d5db;\n      text-decoration: none;\n      font-size: 0.95rem;\n      font-weight: 500;\n      border-radius: 8px;\n      transition: all 0.2s ease;\n    }\n    .drawer-link:hover {\n      background-color: #1f2937;\n      color: #ffffff;\n    }\n  </style>\n\n  <!-- 1. The Hidden State Controller -->\n  <input type=\"checkbox\" id=\"drawer-toggle\" />\n\n  <!-- 2. The Open Button -->\n  <label for=\"drawer-toggle\" class=\"drawer-trigger\">\n    <svg\n      width=\"18\"\n      height=\"18\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n    >\n      <line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"></line>\n      <line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"></line>\n      <line x1=\"3\" y1=\"18\" x2=\"21\" y2=\"18\"></line>\n    </svg>\n    Menu\n  </label>\n\n  <!-- 3. The Dark Overlay Backdrop (Clicking it closes the drawer) -->\n  <label for=\"drawer-toggle\" class=\"drawer-overlay\"></label>\n\n  <!-- 4. The Drawer Layout Block -->\n  <aside class=\"drawer-panel\">\n    <div class=\"drawer-header\">\n      <h2>Studio Navigation</h2>\n      <label for=\"drawer-toggle\" class=\"drawer-close\" aria-label=\"Close menu\"\n        >&times;</label\n      >\n    </div>\n\n    <!-- JSON Compilation Target -->\n    <ul id=\"drawer-target\" class=\"drawer-links\"></ul>\n  </aside>\n\n  <!-- 5. The Compilation Script -->\n  <script>\n    // JSON Routing Data\n    const menuRoutes = [\n      { title: \"Artists view (example)\", href: \"/artists/decibel_force\" },\n      { title: \"Roadmap\", href: \"/roadmap\" },\n      { title: \"Budget\", href: \"/budget\" },\n    ];\n\n    /**\n     * Maps the JSON routing objects into pure HTML list items.\n     */\n    function compileMenu(items) {\n      const targetContainer = document.getElementById(\"drawer-target\");\n      if (!targetContainer || !items.length) return;\n\n      const compiledHtml = items\n        .map(\n          (item) => `\n        <li>\n          <a href=\"${item.href}\" class=\"drawer-link\">${item.title}</a>\n        </li>\n      `,\n        )\n        .join(\"\\n\");\n\n      targetContainer.innerHTML = compiledHtml;\n    }\n\n    // Trigger target compilation immediately when document mounts\n    document.addEventListener(\"DOMContentLoaded\", () => {\n      compileMenu(menuRoutes);\n    });\n  </script>\n</div>\n\n    </div>\n    <div class=\"artist-hero\">\n  <!-- 1. Responsive Picture Stack -->\n  <picture class=\"hero-picture\">\n    <!-- Mobile Portrait (4:5) (< 640px) -->\n    <source\n      type=\"image/avif\"\n      media=\"(max-width: 639px)\"\n      srcset=\"{{heroImage}}_mobile.avif\"\n    />\n    <source\n      type=\"image/webp\"\n      media=\"(max-width: 639px)\"\n      srcset=\"{{heroImage}}_mobile.webp\"\n    />\n\n    <source\n      type=\"image/avif\"\n      media=\"(max-width: 1023px)\"\n      srcset=\"{{heroImage}}_tablet.avif\"\n    />\n    <source\n      type=\"image/webp\"\n      media=\"(max-width: 1023px)\"\n      srcset=\"{{heroImage}}_tablet.webp\"\n    />\n\n    <!-- Desktop Master (16:9) (>= 1024px) -->\n    <source type=\"image/avif\" srcset=\"{{heroImage}}_desktop.avif\" />\n    <source type=\"image/webp\" srcset=\"{{heroImage}}_desktop.webp\" />\n\n    <!-- Legacy Fallback JPG -->\n    <img\n      src=\"{{heroImage}}_desktop.jpg\"\n      alt=\"{{title}}\"\n      class=\"hero-img\"\n      loading=\"eager\"\n    />\n  </picture>\n\n  <!-- 2. Independent Gradient Overlay for Readability -->\n  <div class=\"hero-gradient-overlay\"></div>\n\n  <!-- 3. Foreground Content Overlay (Aligned to Bottom) -->\n\n  <div class=\"hero-overlay\">\n    <a href=\"/\" class=\"btn-back\">← Back to Archive</a>\n    <h1 class=\"capitalize-words\">{{title}}</h1>\n    <p class=\"performance-count\">{{count}} Documented</p>\n  </div>\n</div>\n\n    <main class=\"performance-grid\">{{gridHtml}}</main>\n  </body>\n</html>\n","PublicPerformanceCard":"<a\n  href=\"/performance/{{link}}\"\n  class=\"card\"\n  style=\"text-decoration: none; color: inherit\"\n>\n  <picture class=\"card-thumbnail\">\n  <source srcset=\"{{cardImage}}.avif\" type=\"image/avif\" />\n  <source srcset=\"{{cardImage}}.webp\" type=\"image/webp\" />\n  <img\n    src=\"{{cardImage}}.jpg\"\n    alt=\"{{formattedVenueName}} - {{formattedDate}}\"\n    loading=\"lazy\"\n    style=\"width: 100%; height: 100%; object-fit: cover; display: block\"\n  />\n</picture>\n\n\n  <div class=\"card-metadata\">\n    <h3 class=\"capitalize-words h3\">{{formattedVenueName}}</h3>\n    <p class=\"date\">{{formattedDate}}</p>\n  </div>\n</a>\n","PublicPerformance":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <link rel=\"icon\" type=\"image/png\" href=\"/favicon-96x96.png\" sizes=\"96x96\" />\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\" />\n    <link rel=\"shortcut icon\" href=\"/favicon.ico\" />\n    <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\" />\n    <link rel=\"manifest\" href=\"/site.webmanifest\" />\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>{{pageTitle}} | Live Archive</title>\n    <link rel=\"stylesheet\" href=\"/css/review-studio.css\" />\n  </head>\n  <body>\n    <div class=\"studio-container\" x-data=\"privateWorkspace\">\n      <section\n  class=\"player-column\"\n  x-data=\"publicWorkspace\"\n  id=\"'publicPlayerColumn\"\n>\n  <div class=\"meta-title-card\">\n 