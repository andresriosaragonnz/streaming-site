{
  "PrivateDashboard": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>{{pageTitle}} | Live Archive</title>\n    <link rel=\"stylesheet\" href=\"/css/main.css\" />\n  </head>\n  <body>\n    <div style=\"position: fixed; z-index: 20; padding: 4rem\">\n      <div class=\"menu\">\n  <!-- 1. The Hidden State Controller -->\n  <input type=\"checkbox\" id=\"drawer-toggle\" />\n\n  <!-- 2. The Open Button -->\n  <label for=\"drawer-toggle\" class=\"drawer-trigger\">\n    <svg\n      width=\"18\"\n      height=\"18\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n    >\n      <line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"></line>\n      <line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"></line>\n      <line x1=\"3\" y1=\"18\" x2=\"21\" y2=\"18\"></line>\n    </svg>\n    Menu\n  </label>\n\n  <!-- 3. The Dark Overlay Backdrop (Clicking it closes the drawer) -->\n  <label for=\"drawer-toggle\" class=\"drawer-overlay\"></label>\n\n  <!-- 4. The Drawer Layout Block -->\n  <aside class=\"drawer-panel\">\n    <div class=\"drawer-header\">\n      <h2>Studio Navigation</h2>\n      <label for=\"drawer-toggle\" class=\"drawer-close\" aria-label=\"Close menu\"\n        >&times;</label\n      >\n    </div>\n\n    <!-- JSON Compilation Target -->\n    <ul id=\"drawer-target\" class=\"drawer-links\"></ul>\n  </aside>\n\n  <!-- 5. The Compilation Script -->\n  <script>\n    // JSON Routing Data\n    const menuRoutes = [\n      { title: \"Artists view (example)\", href: \"/artists/decibel_force\" },\n      { title: \"Roadmap\", href: \"/roadmap\" },\n      { title: \"Budget\", href: \"/budget\" },\n    ];\n\n    /**\n     * Maps the JSON routing objects into pure HTML list items.\n     */\n    function compileMenu(items) {\n      const targetContainer = document.getElementById(\"drawer-target\");\n      if (!targetContainer || !items.length) return;\n\n      const compiledHtml = items\n        .map(\n          (item) => `\n        <li>\n          <a href=\"${item.href}\" class=\"drawer-link\">${item.title}</a>\n        </li>\n      `,\n        )\n        .join(\"\\n\");\n\n      targetContainer.innerHTML = compiledHtml;\n    }\n\n    // Trigger target compilation immediately when document mounts\n    document.addEventListener(\"DOMContentLoaded\", () => {\n      compileMenu(menuRoutes);\n    });\n  </script>\n</div>\n\n    </div>\n    <div class=\"artist-hero\">\n  <!-- 1. Responsive Picture Stack -->\n  <picture class=\"hero-picture\">\n    <!-- Mobile Portrait (4:5) (< 640px) -->\n    <source\n      type=\"image/avif\"\n      media=\"(max-width: 639px)\"\n      srcset=\"{{heroImage}}_mobile.avif\"\n    />\n    <source\n      type=\"image/webp\"\n      media=\"(max-width: 639px)\"\n      srcset=\"{{heroImage}}_mobile.webp\"\n    />\n\n    <source\n      type=\"image/avif\"\n      media=\"(max-width: 1023px)\"\n      srcset=\"{{heroImage}}_tablet.avif\"\n    />\n    <source\n      type=\"image/webp\"\n      media=\"(max-width: 1023px)\"\n      srcset=\"{{heroImage}}_tablet.webp\"\n    />\n\n    <!-- Desktop Master (16:9) (>= 1024px) -->\n    <source type=\"image/avif\" srcset=\"{{heroImage}}_desktop.avif\" />\n    <source type=\"image/webp\" srcset=\"{{heroImage}}_desktop.webp\" />\n\n    <!-- Legacy Fallback JPG -->\n    <img\n      src=\"{{heroImage}}_desktop.jpg\"\n      alt=\"{{title}}\"\n      class=\"hero-img\"\n      loading=\"eager\"\n    />\n  </picture>\n\n  <!-- 2. Independent Gradient Overlay for Readability -->\n  <div class=\"hero-gradient-overlay\"></div>\n\n  <!-- 3. Foreground Content Overlay (Aligned to Bottom) -->\n\n  <div class=\"hero-overlay\">\n    <a href=\"/\" class=\"btn-back\">← Back to Archive</a>\n    <h1 class=\"capitalize-words\">{{title}}</h1>\n    <p class=\"performance-count\">{{count}} Documented</p>\n  </div>\n</div>\n\n    <main class=\"performance-grid\">{{gridHtml}}</main>\n  </body>\n</html>\n",
  "PrivatePerformanceCard": "<a\n  href=\"/private/performance/{{link}}\"\n  class=\"card\"\n  style=\"text-decoration: none; color: inherit\"\n>\n  <picture class=\"card-thumbnail\">\n  <source srcset=\"{{cardImage}}.avif\" type=\"image/avif\" />\n  <source srcset=\"{{cardImage}}.webp\" type=\"image/webp\" />\n  <img\n    src=\"{{cardImage}}.jpg\"\n    alt=\"{{formattedVenueName}} - {{formattedDate}}\"\n    loading=\"lazy\"\n    style=\"width: 100%; height: 100%; object-fit: cover; display: block\"\n  />\n</picture>\n\n\n  <div class=\"card-metadata\">\n    <h3 class=\"capitalize-words\">{{formattedVenueName}}</h3>\n    <p class=\"date\">{{formattedDate}}</p>\n  </div>\n</a>\n",
  "PrivatePerformance": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Performance</title>\n    <link rel=\"stylesheet\" href=\"/css/review-studio.css\" />\n  </head>\n  <body>\n    <div class=\"studio-container\" x-data=\"privateWorkspace\">\n      <section class=\"player-column\">\n  <div class=\"meta-title-card\">\n    <div><div class=\"menu\">\n  <!-- 1. The Hidden State Controller -->\n  <input type=\"checkbox\" id=\"drawer-toggle\" />\n\n  <!-- 2. The Open Button -->\n  <label for=\"drawer-toggle\" class=\"drawer-trigger\">\n    <svg\n      width=\"18\"\n      height=\"18\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n    >\n      <line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"></line>\n      <line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"></line>\n      <line x1=\"3\" y1=\"18\" x2=\"21\" y2=\"18\"></line>\n    </svg>\n    Menu\n  </label>\n\n  <!-- 3. The Dark Overlay Backdrop (Clicking it closes the drawer) -->\n  <label for=\"drawer-toggle\" class=\"drawer-overlay\"></label>\n\n  <!-- 4. The Drawer Layout Block -->\n  <aside class=\"drawer-panel\">\n    <div class=\"drawer-header\">\n      <h2>Studio Navigation</h2>\n      <label for=\"drawer-toggle\" class=\"drawer-close\" aria-label=\"Close menu\"\n        >&times;</label\n      >\n    </div>\n\n    <!-- JSON Compilation Target -->\n    <ul id=\"drawer-target\" class=\"drawer-links\"></ul>\n  </aside>\n\n  <!-- 5. The Compilation Script -->\n  <script>\n    // JSON Routing Data\n    const menuRoutes = [\n      { title: \"Artists view (example)\", href: \"/artists/decibel_force\" },\n      { title: \"Roadmap\", href: \"/roadmap\" },\n      { title: \"Budget\", href: \"/budget\" },\n    ];\n\n    /**\n     * Maps the JSON routing objects into pure HTML list items.\n     */\n    function compileMenu(items) {\n      const targetContainer = document.getElementById(\"drawer-target\");\n      if (!targetContainer || !items.length) return;\n\n      const compiledHtml = items\n        .map(\n          (item) => `\n        <li>\n          <a href=\"${item.href}\" class=\"drawer-link\">${item.title}</a>\n        </li>\n      `,\n        )\n        .join(\"\\n\");\n\n      targetContainer.innerHTML = compiledHtml;\n    }\n\n    // Trigger target compilation immediately when document mounts\n    document.addEventListener(\"DOMContentLoaded\", () => {\n      compileMenu(menuRoutes);\n    });\n  </script>\n</div>\n</div>\n    <div class=\"meta-title-card-right\">\n      <h2>{{studioTitle}}</h2>\n    </div>\n  </div>\n\n  <div class=\"video-player-mock\">\n    <div\n      x-show=\"active.source\"\n      style=\"width: 100%; height: 100%; background: #000\"\n    >\n      <div x-show=\"active.source\" style=\"width: 100%; height: 100%; background: #000\">\n  <video\n    id=\"r2-stream-player\"\n    controls\n    playsinline\n    preload=\"metadata\"\n    style=\"width: 100%; height: 100%; object-fit: contain; display: block\"\n  ></video>\n</div>\n\n    </div>\n  </div>\n\n  <div class=\"meta-workspace-card\">\n  <div class=\"studio-controls-group\">\n    <div class=\"input-field-group\">\n      <input\n        type=\"text\"\n        x-model=\"active.title\"\n        @input=\"$store.review.syncStore($store.review.currentIndex, active.title)\"\n      />\n    </div>\n\n    <button\n      @click=\"$store.review.toggleStatus($store.review.currentIndex)\"\n      type=\"button\"\n      class=\"btn-status\"\n      :class=\"active.status === 'public' ? 'btn-public' : 'btn-private'\"\n    >\n      <span x-text=\"active.status === 'public' ? 'Public' : 'Private'\"></span>\n    </button>\n    <div class=\"studio-controls-status-count-container\">\n      <span\n        x-text=\"$store.review.getCount()\"\n        class=\"studio-controls-status-count\"\n      ></span>\n      <span\n        x-text=\"$store.review.getCountPrivate()\"\n        class=\"studio-controls-status-count\"\n      ></span>\n    </div>\n    <div class=\"status-action-wrapper\">\n      <!-- Commit Action -->\n      <button\n        x-show=\"$store.review.changed\"\n        @click=\"$store.review.openCommitModal()\"\n        type=\"button\"\n        class=\"btn-status btn-public\"\n      >\n        <span>Commit</span>\n      </button>\n    </div>\n  </div>\n  <!-- COMMIT MODAL TEMPLATE -->\n<div\n  x-show=\"$store.review.isCommitModalOpen\"\n  x-cloak\n  @keydown.escape.window=\"$store.review.closeCommitModal()\"\n  class=\"modal-backdrop\"\n>\n  <div @click.away=\"$store.review.closeCommitModal()\" class=\"modal-card\">\n    <div class=\"modal-header\">\n      <h2>Review Public Segments</h2>\n      <p class=\"modal-subtitle\">The following segments will be made public:</p>\n    </div>\n\n    <!-- List of changed segments -->\n    <ul class=\"commit-segment-list\">\n      <template\n        x-for=\"(seg, idx) in $store.review.getPublicSegments()\"\n        :key=\"seg.id ?? idx\"\n      >\n        <li class=\"commit-segment-item\">\n          <span x-text=\"seg.title\" class=\"segment-title\"></span>\n          <span\n            x-text=\"seg.status\"\n            :class=\"seg.status === 'public' ? 'status-tag-public' : 'status-tag-private'\"\n            class=\"status-tag\"\n          ></span>\n        </li>\n      </template>\n    </ul>\n    <!-- List of changed segments -->\n    <ul class=\"commit-segment-list\">\n      <template\n        x-for=\"(seg, idx) in $store.review.gePrivateSegments()\"\n        :key=\"seg.id ?? idx\"\n      >\n        <li class=\"commit-segment-item\">\n          <span x-text=\"seg.title\" class=\"segment-title\"></span>\n          <span\n            x-text=\"seg.status\"\n            :class=\"seg.status === 'public' ? 'status-tag-public' : 'status-tag-private'\"\n            class=\"status-tag\"\n          ></span>\n        </li>\n      </template>\n    </ul>\n\n    <!-- APRA AMCOS DIRECT LICENSING AGREEMENT -->\n    <div\n      x-data=\"{ agreed: false, expanded: false }\"\n      class=\"license-agreement-container\"\n    >\n      <div class=\"agreement-header\">\n        <label class=\"checkbox-label\">\n          <input type=\"checkbox\" x-model=\"agreed\" id=\"apra-agreement-check\" />\n          <span\n            >I agree to the Direct Synchronisation & Online Streaming\n            Licence</span\n          >\n        </label>\n\n        <button\n          type=\"button\"\n          class=\"btn-toggle-terms\"\n          @click=\"expanded = !expanded\"\n          x-text=\"expanded ? 'Hide Terms ▲' : 'View Terms ▼'\"\n        >\n          View Terms ▼\n        </button>\n      </div>\n\n      <!-- Expandable Terms Container -->\n\n      <div x-show=\"expanded\" x-collapse class=\"contract-body\">\n  <h4>DIRECT SYNCHRONISATION AND ONLINE STREAMING LICENCE AGREEMENT</h4>\n\n  <p>\n    <strong>1. PARTIES</strong><br />\n    This Agreement is between the Platform and the undersigned artist/copyright\n    owner (\"Licensor\").\n  </p>\n\n  <p>\n    <strong>2. GRANT OF LICENCE</strong><br />\n    The Licensor grants the Platform a worldwide, non-exclusive, royalty-free,\n    direct licence to:<br />\n    a) Synchronize the musical composition and sound recording entitled\n    <strong x-text=\"active?.title || 'the selected works'\"></strong> with video\n    footage uploaded by the videographer.<br />\n    b) Stream, transmit, and display the resulting audiovisual work on the\n    Platform's website and related non-commercial channels.\n  </p>\n\n  <p>\n    <strong>3. DIRECT LICENSING DECLARATION (APRA AMCOS BYPASS)</strong><br />\n    The Licensor acknowledges that they retain full ownership of the Work.\n    Pursuant to APRA AMCOS direct licensing rules, the Licensor explicitly\n    authorizes the Platform to stream and synchronize the Work without requiring\n    third-party licensing or fee collection from APRA AMCOS or PPCA.\n  </p>\n\n  <p>\n    <strong>4. WARRANTIES & INDEMNITY</strong><br />\n    The Licensor warrants that:<br />\n    a) They are the sole creator and copyright owner of the Work, or hold all\n    necessary authority to grant this licence.<br />\n    b) The Work is 100% original and contains no unlicensed third-party samples,\n    cover compositions, or unauthorized media.<br />\n    c) The Licensor agrees to indemnify and hold harmless the Platform against\n    any third-party copyright claims or licensing demands arising from the\n    streaming of this Work.\n  </p>\n\n  <p>\n    <strong>5. TERM & TERMINATION</strong><br />\n    This licence remains in effect indefinitely until revoked in writing by the\n    Licensor. Upon receiving a written revocation, the Platform shall remove the\n    media within 5 business days.\n  </p>\n</div>\n\n      <!-- Modal Actions Gated by Checkbox -->\n      <div class=\"modal-actions\">\n        <button\n          @click=\"$store.review.closeCommitModal()\"\n          type=\"button\"\n          class=\"btn-modal btn-modal-cancel\"\n        >\n          Cancel\n        </button>\n        <button\n          @click=\"$store.review.submitCommit()\"\n          type=\"button\"\n          :disabled=\"!agreed\"\n          class=\"btn-modal btn-modal-confirm\"\n        >\n          Confirm Changes\n        </button>\n      </div>\n    </div>\n  </div>\n</div>\n\n</div>\n\n</section>\n <aside class=\"playlist-sidebar\">\n  <div class=\"carousel-wrapper\" x-data=\"carousel\">\n    <button\n      type=\"button\"\n      class=\"carousel-nav-btn nav-left\"\n      x-show=\"canScrollLeft\"\n      @click=\"scroll('left')\"\n      x-transition\n      x-cloak\n    >\n      ‹\n    </button>\n\n    <div\n      class=\"sidebar-scroll-list\"\n      x-ref=\"scrollList\"\n      @scroll.debounce.50ms=\"checkScroll()\"\n    >\n      <template\n        x-for=\"(seg, idx) in $store.review.segments\"\n        :key=\"seg.id || idx\"\n      >\n        {{cards}}\n      </template>\n    </div>\n\n    <button\n      type=\"button\"\n      class=\"carousel-nav-btn nav-right\"\n      x-show=\"canScrollRight\"\n      @click=\"scroll('right')\"\n      x-transition\n      x-cloak\n    >\n      ›\n    </button>\n  </div>\n</aside>\n\n    </div>\n\n    <script type=\"application/json\" id=\"studio-segments-data\">\n      {{jsonSegments}}\n    </script>\n    <!-- GLOBAL TOAST NOTIFICATION COMPONENT -->\n<div\n  x-data\n  x-show=\"$store.toast.show\"\n  x-transition:enter=\"toast-enter\"\n  x-transition:enter-start=\"toast-enter-start\"\n  x-transition:enter-end=\"toast-enter-end\"\n  x-transition:leave=\"toast-leave\"\n  x-transition:leave-start=\"toast-leave-start\"\n  x-transition:leave-end=\"toast-leave-end\"\n  x-cloak\n  class=\"toast-container\"\n  :class=\"$store.toast.type\"\n>\n  <div class=\"toast-content\">\n    <span\n      x-text=\"$store.toast.type === 'success' ? '✓' : '⚠'\"\n      class=\"toast-icon\"\n    ></span>\n    <span x-text=\"$store.toast.message\" class=\"toast-message\"></span>\n    <button @click=\"$store.toast.dismiss()\" type=\"button\" class=\"toast-close\">\n      &times;\n    </button>\n  </div>\n</div>\n\n  </body>\n  <script type=\"module\" src=\"/js/privateApp.js\"></script>\n</html>\n",
  "PrivateSegmentCard": "<div\n  @click=\"$store.review.currentIndex = idx\"\n  class=\"sidebar-item-card\"\n  :class=\"[\n    $store.review.currentIndex === idx ? 'item-active-highlight' : ''\n  ]\"\n>\n  <div class=\"item-meta\">\n    <picture class=\"item-thumbnail\">\n  <source :srcset=\"`${seg.cardImage}.avif`\" type=\"image/avif\" />\n  <source :srcset=\"`${seg.cardImage}.webp`\" type=\"image/webp\" />\n  <img\n    :src=\"`${seg.cardImage}.jpg`\"\n    :alt=\"seg.title\"\n    loading=\"lazy\"\n    style=\"width: 100%; height: 100%; object-fit: cover; display: block\"\n  />\n</picture>\n\n    <div class=\"status-text\">\n      <span x-text=\"seg.status === 'public' ? 'Public' : 'Private'\"></span>\n      <span x-text=\"seg.formatedDuration\"></span>\n    </div>\n  </div>\n\n  <div class=\"title-text\">\n    <!-- FIXED: Linked to the dynamic, reactive title string -->\n    <span x-text=\"seg.title\"></span>\n  </div>\n</div>\n",
