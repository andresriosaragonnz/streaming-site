{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "jsx": "react-jsx",
    "jsxImportSource": "@kitajs/html",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun", "node", "@cloudflare/workers-types", "@kitajs/html"]
  },
  "include": ["src/**/*", "scripts/**/*"]
}
